<UserControl x:Class="Shorty.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modern="http://schemas.inkore.net/lib/ui/wpf/modern"
             MinWidth="760"
             MinHeight="640">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Orientation="Vertical">
            <TextBlock Text="API" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,12,10" />
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="0" PasswordChanged="ApiKeyPasswordBox_OnPasswordChanged" />
                    <TextBox x:Name="ApiKeyTextBox" Grid.Column="0" TextChanged="ApiKeyTextBox_OnTextChanged" Visibility="Collapsed" />
                    <CheckBox Grid.Column="1" Content="Show" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ShowApiKey, Mode=TwoWay}" Checked="ShowApiKey_OnChanged" Unchecked="ShowApiKey_OnChanged" />
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint URL" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Text="{Binding EndpointUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Default model" VerticalAlignment="Center" Margin="0,0,12,10" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" IsEditable="True" ItemsSource="{Binding ModelOptions}" Text="{Binding DefaultModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Test connection" Command="{Binding TestConnectionCommand}" MinWidth="124" />
                    <TextBlock Text="{Binding TestStatus}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Behavior" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Default preset" VerticalAlignment="Center" Margin="0,0,12,10" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" ItemsSource="{Binding PresetNames}" Text="{Binding DefaultPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cache size" VerticalAlignment="Center" Margin="0,0,12,10" />
                <modern:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Minimum="1" Maximum="200" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Inline" Value="{Binding CacheSizeValue, Mode=TwoWay}" Width="160" HorizontalAlignment="Left" />

                <CheckBox Grid.Row="2" Grid.Column="1" Content="Show character count in subtitle" IsChecked="{Binding ShowCharacterCount, Mode=TwoWay}" />
            </Grid>

            <TextBlock Text="Presets" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add" Command="{Binding AddPresetCommand}" MinWidth="72" Margin="0,0,8,0" />
                    <Button Content="Edit" Command="{Binding EditPresetCommand}" MinWidth="72" Margin="0,0,8,0" />
                    <Button Content="Delete" Command="{Binding DeletePresetCommand}" MinWidth="72" Margin="0,0,8,0" />
                    <Button Content="Duplicate" Command="{Binding DuplicatePresetCommand}" MinWidth="88" />
                </StackPanel>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="160" />
                        <DataGridTextColumn Header="Temperature" Binding="{Binding Temperature, StringFormat=F2}" Width="110" />
                        <DataGridTextColumn Header="System" Binding="{Binding SystemPreview}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version, StringFormat=Version {0}}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <modern:HyperlinkButton Content="Repository" Command="{Binding OpenRepoCommand}" Margin="0,0,10,0" />
                <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
